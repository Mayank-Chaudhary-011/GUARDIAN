# ============================================================
#  GUARDIAN — Environment Configuration Template
#  Copy this file to .env and fill in your real values
#  NEVER commit .env to GitHub — only commit .env.example
# ============================================================

# ── PRIMARY LLM (OpenAI) ────────────────────────────────────
OPENAI_API_KEY=

# ── FALLBACK 1 (Groq) ───────────────────────────────────────
GROQ_API_KEY=

# ── FALLBACK 2 (Ollama — Local, No API Key Needed) ──────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── MODEL SELECTION ─────────────────────────────────────────
PRIMARY_MODEL=gpt-4o
EVAL_MODEL=gpt-4o-mini

# ── DATABASE (Supabase) ─────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── ALERTING (Slack) ────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── OBSERVABILITY (LangSmith) ───────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=guardian

# ── APP SETTINGS ────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000

# ── CIRCUIT BREAKER ─────────────────────────────────────────
CIRCUIT_BREAKER_FAIL_MAX=3
CIRCUIT_BREAKER_RESET_TIMEOUT=30

# ── REGRESSION DETECTOR ─────────────────────────────────────
REGRESSION_THRESHOLD_PERCENT=3
REGRESSION_WINDOW=10

# ── SAFETY RED TEAM ─────────────────────────────────────────
SAFETY_SCORE_THRESHOLD=70